# ---------------------------------------------------------------------------
# Server (apps/server) — salin menjadi apps/server/.env
# Jangan pernah commit file .env yang berisi nilai asli.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (dipakai Sprint 2 saat realtime membaca/menulis board).
# Di lokal, `npm run dev:local` mengisi ini otomatis lewat PGlite TCP server.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Origin yang diizinkan (HTTP + WebSocket handshake).
# Pisahkan dengan koma bila lebih dari satu. Contoh produksi:
# CORS_ORIGINS=https://synccanvas.example.com,https://www.synccanvas.example.com
CORS_ORIGINS=http://localhost:3000

# Kapasitas & lifecycle room (in-memory)
MAX_ROOMS=500
MAX_ROOM_MEMBERS=50
MAX_STROKES_PER_ROOM=2000
ROOM_IDLE_TTL_MS=1800000
ROOM_SWEEP_INTERVAL_MS=60000

# Rate limit per socket (token bucket)
RATE_LIMIT_CURSOR_PER_SEC=60
RATE_LIMIT_WRITE_PER_SEC=30
