# ---------------------------------------------------------------------------
# Client (apps/client) — salin menjadi apps/client/.env.local
#
# Hanya variabel berprefix NEXT_PUBLIC_ yang tersedia di browser.
# Jangan pernah menaruh secret (AUTH_SECRET, DB URL) di variabel NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# URL HTTP Socket.io server (client akan upgrade ke WebSocket).
# Jika server berada di domain yang sama di belakang reverse proxy, gunakan
# URL origin yang sama, mis. https://synccanvas.example.com
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Auth.js -----------------------------------------------------------------
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth (Google Cloud Console → Credentials → OAuth client ID)
# Authorized redirect URI lokal: http://localhost:3000/api/auth/callback/google
# Produksi: https://<domain-vercel>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Allowlist akses. Minimal salah satu harus diisi; jika kosong semua login
# ditolak (fail-closed). Pisahkan dengan koma.
# Contoh untuk akun Gmail tunggal:
ALLOWED_EMAILS=anggota@perusahaan.com
# Untuk Google Workspace dengan domain sendiri, isi tanpa tanda @:
ALLOWED_EMAIL_DOMAINS=

# Login kredensial tanpa Google. Hanya aktif bila NODE_ENV bukan production.
AUTH_DEV_LOGIN=false

# Workspace default yang dibuat otomatis saat user pertama masuk.
DEFAULT_WORKSPACE_SLUG=internal
DEFAULT_WORKSPACE_NAME=SyncCanvas Internal

# --- Database ----------------------------------------------------------------
# Untuk produksi (Neon). Di lokal, `npm run dev:local` mengisi variabel ini
# otomatis lewat PGlite TCP server.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
